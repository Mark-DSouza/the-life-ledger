# Credentials for the local Supabase stack (`bun db:start`). Copy to `.env.local`
# to point the app and Playwright at local Postgres instead of the hosted
# Lovable project:
#
#   cp .env.local.example .env.local
#
# `.env.local` wins over `.env` for Vite, Bun and playwright.config.ts alike, so
# `.env` keeps holding the hosted credentials untouched — delete `.env.local` to
# switch back.
#
# Copy this file whole; do not override a subset. Every variable here is read by
# a different consumer — the browser reads VITE_*, server fns read the unprefixed
# pair, global-setup reads E2E_* — and a partial copy points them at different
# backends. The failures that causes name neither file: server fns 401 because
# `requireSupabaseAuth` checks a local token against the hosted project, or
# sign-in fails because the hosted account's credentials were kept.
#
# None of these are secrets. The Supabase CLI issues the same fixed demo keys on
# every machine; they are worthless outside 127.0.0.1.

SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The local stack's service-role key, which bypasses RLS. No code in this repo
# reads it — the app and the e2e helpers deliberately go through the anon key
# plus a real user JWT, so they exercise the same RLS policies hosted does.
# It's here because the local stack issues one and admin chores need it: seeding
# or wiping another user's rows, or reading a table RLS would hide. Reach for it
# from a throwaway script, never from app or test code, or the thing under test
# stops being the thing that runs in production. The hosted project has no
# equivalent in this repo, which is the other reason it lives in this file only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Keep the URLs spelled "localhost", not "127.0.0.1" — including if you paste
# them from `bun db:status`, which prints the 127.0.0.1 form. supabase-js names
# its session storage key after the first label of the URL's hostname, so the
# two spellings produce different keys (`sb-localhost-` vs `sb-127-`) and a
# session written under one is invisible to a page built with the other.
#
# VITE_SUPABASE_PROJECT_ID is deliberately absent: nothing in the app or the
# e2e setup reads it any more. Lovable still writes it into `.env` for the
# hosted project, which is why it survives there.

# The account seeded by supabase/seed.sql. Must match the values there.
E2E_TEST_EMAIL=e2e@lifeos.local
E2E_TEST_PASSWORD=e2e-local-password
